# HALO verifies content hashes of committed files (model releases, verifier source, manifests).
# Line-ending conversion changes those bytes, so every checkout must be byte-exact: LF everywhere,
# binaries untouched. Do not remove this file or set core.autocrlf for this repository.
* text=auto eol=lf
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ico   binary
*.zip   binary
*.gz    binary
*.tar   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.key   binary
*.srs   binary
*.ezkl  binary
*.onnx  binary
*.bytes binary
