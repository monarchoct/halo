# Public HTTPS edge for the HALO services. Certificates are issued automatically by Caddy.
# The website itself is served from Cloudflare; these hostnames are what deployment.json points at.
# The operator only ever talks to loopback or public HTTPS on 443 (sdk/safe-fetch.mjs), so its own IPFS peers
# and the live relay are reached through these hostnames too, even from the same host. Keep every record here
# DNS-only (no Cloudflare proxy): the relays stream, and the operator pins the resolved public address.
(ipfs_peer) {
	@authorized {
		header Authorization "Bearer {$HALO_IPFS_PEER_TOKEN}"
		path /api/v0/id /api/v0/block/put /api/v0/block/get /api/v0/pin/ls
	}
	# route keeps the written order: a matched reverse_proxy terminates, anything else falls through to 403.
	route {
		reverse_proxy @authorized {args[0]}:5001
		respond 403
	}
}
api.{$HALO_DOMAIN} {
	reverse_proxy api:8787
	header Cache-Control "public, max-age=5"
	encode zstd gzip
}
operations.{$HALO_DOMAIN} {
	reverse_proxy operations:8796
	encode zstd gzip
}
live.{$HALO_DOMAIN} {
	reverse_proxy relays:8791 {
		flush_interval -1
	}
}
screens.{$HALO_DOMAIN} {
	reverse_proxy relays:8795 {
		flush_interval -1
	}
}
artifacts.{$HALO_DOMAIN} {
	# Manifest publication (POST /v1/manifests, replicated to three peers) and integrity-checked reads (GET /ipfs/:cid).
	reverse_proxy artifacts:8790
	encode zstd gzip
}
inference.{$HALO_DOMAIN} {
	# HTTPS front for the Akash llama.cpp lease (the runtime refuses plain-HTTP inference backends off loopback).
	# The bearer key still travels with every request; Caddy only adds TLS. Upstream comes from .env.
	@allowed path /v1/chat/completions /v1/models /health
	route {
		reverse_proxy @allowed {$HALO_INFERENCE_UPSTREAM} {
			# The Akash ingress routes by Host, so send the upstream's own host name, not ours.
			header_up Host {upstream_hostport}
			transport http {
				read_timeout 180s
			}
		}
		respond 404
	}
}
ipfs-one.{$HALO_DOMAIN} {
	import ipfs_peer ipfs
}
ipfs-two.{$HALO_DOMAIN} {
	import ipfs_peer ipfs-two
}
ipfs-three.{$HALO_DOMAIN} {
	import ipfs_peer ipfs-three
}
