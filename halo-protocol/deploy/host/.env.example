# Copy to /srv/halo/.env. Public values only; credentials live in secrets/*.env (mode 0600, owner halo).
HALO_DOMAIN=halo.example.com
# Akash inference lease (host:port of the llama.cpp ingress, plain HTTP); Caddy publishes it as https://inference.<domain>
HALO_INFERENCE_UPSTREAM=REPLACE.ingress.provider.example:80
HALO_RUNTIME_IMAGE=ghcr.io/monarchoct/halo-runtime@sha256:REPLACE_WITH_THE_REVIEWED_DIGEST

# secrets/migrate.env      HALO_MIGRATION_URL=postgresql://halo_migrator:...@postgres:5432/halo
# secrets/operations.env   HALO_OPERATIONS_READER_URL=postgresql://halo_operations_reader:...@postgres:5432/halo
#                          HALO_SOCIAL_WRITER_URL=postgresql://halo_social_writer:...@postgres:5432/halo
#                          HALO_X_CLIENT_ID=...   HALO_X_CLIENT_SECRET=...
# secrets/relays.env       HALO_RELAY_FANOUT_URL=postgresql://halo_relay:...@postgres:5432/halo
# secrets/operator.env     HALO_OPERATOR_DATABASE_URL=postgresql://halo_operator:...@postgres:5432/halo
#                          HALO_INFERENCE_AUTH=Bearer <the HALO_INFERENCE_KEY of the Akash lease>
#                          (pinning services, if used instead of local peers: HALO_IPFS_PEER_TWO_AUTH=Bearer ...)
# secrets/operator.key     the operator's gas-wallet private key, one line, mode 0600
# secrets/postgres_admin   the PostgreSQL superuser password, one line
